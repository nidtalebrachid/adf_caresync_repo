{
	"name": "pl send email",
	"properties": {
		"activities": [
			{
				"name": "read all tables status",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 2,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "select * from ctrl.audit_log where adf_run_id = @{pipeline().parameters.adf_run_id}",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "ds_AzureSql",
						"type": "DatasetReference"
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "prepare body heaader",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "body header",
					"value": "Ingestion and transformation for caresync project has been completed and below is the status : "
				}
			},
			{
				"name": "prepare footer",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "body header",
					"value": "for any support please reach to idmandil@gmail.com"
				}
			},
			{
				"name": "prepare email subject",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "email subject",
					"value": {
						"value": "@{pipeline().globalParameters.env}| SUCCESS | CARESYNC MASTER RUN",
						"type": "Expression"
					}
				}
			}
		],
		"parameters": {
			"adf_run_id": {
				"type": "string",
				"defaultValue": "ac9c36d1-02d2-42d0-a191-99368b8d282c"
			}
		},
		"variables": {
			"body header": {
				"type": "String"
			},
			"email subject": {
				"type": "String"
			}
		},
		"annotations": []
	}
}